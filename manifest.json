{
  "manifest_version": 3,
  "name": "Desmos Transcriber",
  "version": "1.0.0",
  "description": "Transcribe Desmos equations into proper mathematical notation",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.desmos.com/*",
    "https://saved-work.desmos.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' https://www.desmos.com; object-src 'self'"
  },
  "action": {
    "default_title": "Transcribe Desmos Equations"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["transcribe.html", "transcribe.js", "styles.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.desmos.com/calculator/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
